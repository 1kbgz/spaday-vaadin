{
  "name": "spaday-vaadin",
  "version": "0.1.0",
  "description": "Vaadin for spaday",
  "repository": "git@github.com:1kbgz/spaday-vaadin.git",
  "author": "1kbgz <dev@1kbgz.com>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "unpkg": "dist/cdn/index.js",
  "jsdelivr": "dist/cdn/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "types": "./dist/esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:debug": "node build.mjs --debug",
    "build:prod": "node build.mjs",
    "build:types": "tsc",
    "build": "npm-run-all build:prod build:types",
    "clean": "rm -rf dist playwright-report ../spaday_vaadin/extension",
    "dev": "npm-run-all -p start watch",
    "lint": "oxlint . && oxfmt --check \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "fix": "oxlint --fix . && oxfmt --write \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "manifest": "node tools/manifest.mjs",
    "preinstall": "npx only-allow pnpm",
    "prepack": "npm run build",
    "start": "http-server -p 3000 -o examples/",
    "start:tests": "http-server -p 3000 ",
    "test": "TZ=UTC playwright test",
    "watch": "nodemon --watch src -e ts,css,html --exec \"pnpm build:debug\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "cpy": "^13.2.3",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "lightningcss": "^1.33.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vaadin/a11y-base": "25.2.10",
    "@vaadin/button": "25.2.10",
    "@vaadin/checkbox": "25.2.10",
    "@vaadin/combo-box": "25.2.10",
    "@vaadin/component-base": "25.2.10",
    "@vaadin/date-picker": "25.2.10",
    "@vaadin/dialog": "25.2.10",
    "@vaadin/field-base": "25.2.10",
    "@vaadin/grid": "25.2.10",
    "@vaadin/icon": "25.2.10",
    "@vaadin/input-container": "25.2.10",
    "@vaadin/item": "25.2.10",
    "@vaadin/list-box": "25.2.10",
    "@vaadin/lit-renderer": "25.2.10",
    "@vaadin/notification": "25.2.10",
    "@vaadin/overlay": "25.2.10",
    "@vaadin/select": "25.2.10",
    "@vaadin/tabs": "25.2.10",
    "@vaadin/text-field": "25.2.10",
    "@vaadin/vaadin-lumo-styles": "25.2.10",
    "@vaadin/vaadin-themable-mixin": "25.2.10"
  }
}
